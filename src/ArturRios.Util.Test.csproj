<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Authors>Artur Rios</Authors>
    <Company>Artur Rios</Company>
    <Description>Test utilities for .NET projects: custom xUnit assertions and environment-aware test attributes, in-memory repository and scheduler fakes, and a base class for functional web API tests.</Description>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- Referencing xunit makes the SDK infer this is a test project (IsPackable=false).
             This is a shippable library, so pack it and keep the test runner out of it. -->
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
    <Nullable>enable</Nullable>
    <PackageId>ArturRios.Util.Test</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://artur-rios.github.io/dotnet-test-util</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>utilities, test, .net</PackageTags>
    <RepositoryUrl>https://github.com/artur-rios/dotnet-test-util</RepositoryUrl>
    <Version>2.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ArturRios.Configuration" Version="1.1.0" />
    <PackageReference Include="ArturRios.Data.Relational.Core" Version="4.0.0" />
    <PackageReference Include="ArturRios.Mediator" Version="1.0.3" />
    <PackageReference Include="ArturRios.Util" Version="2.0.0" />
    <PackageReference Include="ArturRios.Util.WebApi" Version="3.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>
</Project>
